# Copy this file to backend/.env and fill in real values.

# Google / Gemini API key used by the recipe agent.
GEMINI_API_KEY=your-api-key-here

# Environment name. Production requires JWT_SECRET to be set.
APP_ENV=development

# Secret used to sign JWT access tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string

# Access token lifetime in minutes (default: 7 days).
ACCESS_TOKEN_EXPIRE_MINUTES=10080
